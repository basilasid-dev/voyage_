# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Admin dashboard (/admin) ---------------------------------------------------------------
# Admin is OFF until one of these is set. Generate the hash with:  pnpm admin:hash
ADMIN_PASSWORD_HASH=
# Name recorded in the history log next to every change (optional, default "admin").
ADMIN_NAME=

# Development only: a plain password, ignored when NODE_ENV=production.
# ADMIN_PASSWORD=

# Only if you serve the production site over plain http on a private network (not recommended):
# ADMIN_INSECURE_COOKIES=1

# --- Database -------------------------------------------------------------------------------
# DATABASE_PATH=./data/calicut-bus.db
